  "paths": {
    "/api/v1/artifacts": {
      "get": {
        "summary": "List the artifact catalog.",
        "description": "Returns the complete readable server, player, and replay hierarchy after applying optional filters.",
        "operationId": "artifacts_list",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/recorder_minecraft.api.v1.ListArtifactsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "serverInstanceId",
            "description": "Restrict results to one recorder installation UUID.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "playerUuid",
            "description": "Restrict results to one Minecraft player UUID.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "startedAtOrAfter",
            "description": "Include replays whose connection started at or after this instant.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "startedBefore",
            "description": "Include replays whose connection started before this instant.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "Artifacts"
        ]
      }
    },
    "/api/v1/catalog:refresh": {
      "post": {
        "summary": "Rescan the artifacts root.",
        "description": "Discards the briefly cached catalog snapshot and walks the artifacts root again. Other reads may serve a snapshot up to a few seconds old.",
