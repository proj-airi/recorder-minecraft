{
  "name": "@mc-recorder/root",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Minecraft server-side gameplay recording toolkit",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r -F=\"./apps/*\" build",
    "build:dashboard": "pnpm -r -F @mc-recorder/dashboard build",
    "build:viewer": "pnpm --filter @mc-recorder/viewer build",
    "dev": "pnpm -r -F @mc-recorder/dashboard dev",
    "dev:dashboard": "pnpm -r -F @mc-recorder/dashboard dev",
    "lint": "moeru-lint .",
    "lint:fix": "moeru-lint --fix .",
    "preview:dashboard": "pnpm -r -F @mc-recorder/dashboard preview",
    "test": "pnpm -r --if-present test",
    "test:viewer": "pnpm --filter @mc-recorder/viewer test",
    "typecheck": "pnpm -r -F=\"./apps/*\" --parallel typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-mini": "catalog:",
    "@unocss/preset-web-fonts": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:"
  },
  "workspaces": [
    "apps/**"
  ]
}
