#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${ROOT}/deploy/.env"
COMPOSE=(docker compose --env-file deploy/.env --file deploy/docker-compose.yml)

usage() {
  cat <<'EOF'
Usage: hack/minecraft-server <command> [args...]

Commands:
  prepare   Build and stage the recorder mod and Minecraft config files
  start     Prepare, then start Compose services and wait for health
  stop      Stop Compose services
  restart   Stop, prepare, then start Compose services
  status    Show Compose service status
  logs      Show Compose service logs
EOF
}

require_env_file() {
  if [[ ! -f "${ENV_FILE}" ]]; then
    echo "missing deploy/.env; copy deploy/.env.example to deploy/.env and edit it" >&2
    exit 2
  fi
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

env_value() {
  local key="$1"
  awk -v key="${key}" '
    BEGIN { FS = "=" }
    $0 !~ /^[[:space:]]*(#|$)/ && $1 == key {
      sub(/^[^=]*=/, "")
      print
      exit
    }
  ' "${ENV_FILE}"
}

env_path() {
  local value
  value="$(env_value "$1")"
  if [[ -z "${value}" ]]; then
    echo "missing $1 in deploy/.env" >&2
    exit 2
  fi
  if [[ "${value}" = /* ]]; then
    printf '%s\n' "${value}"
  else
    printf '%s\n' "$(cd "${ROOT}/deploy" && mkdir -p "$(dirname "${value}")" && cd "$(dirname "${value}")" && pwd)/$(basename "${value}")"
  fi
}

json_string_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s\n' "${value}"
}

prepare() {
  require_env_file
  require_command pixi

  cd "${ROOT}"
  pixi run build-recorder-mod

  local mods_dir config_dir config_file jar level_name eula server_name server_instance_id
  mods_dir="$(env_path MC_LOCAL_MODS_HOST_DIR)"
  config_dir="$(env_path MC_CONFIG_SOURCE_HOST_DIR)"
  config_file="$(env_path MC_CONFIG_FILE)"
  mkdir -p "${mods_dir}" "${config_dir}/server-replay"
  if [[ ! -f "${config_file}" ]]; then
    echo "missing recorder config: ${config_file}; run 'pixi run minerec init' first" >&2
    exit 2
  fi

  eula="$(env_value MC_EULA)"
  eula="$(printf '%s' "${eula}" | tr '[:upper:]' '[:lower:]')"
  if [[ "${eula}" != "true" ]]; then
    echo "MC_EULA must be TRUE in deploy/.env after accepting https://aka.ms/MinecraftEULA" >&2
    exit 2
  fi

  jar="$(
    find "${ROOT}/mods/recorder-mod/build/libs" -maxdepth 1 -type f -name '*.jar' \
      ! -name '*-sources.jar' ! -name '*-javadoc.jar' ! -name '*-dev.jar' ! -name '*-all-dev.jar' \
      | sort \
      | tail -n 1
  )"
  if [[ -z "${jar}" ]]; then
    echo "no recorder mod jar found under mods/recorder-mod/build/libs" >&2
    exit 2
  fi
  cp "${jar}" "${mods_dir}/mc-recorder-capture.jar"

  level_name="$(env_value MC_LEVEL_NAME)"
  : "${level_name:=world}"
  level_name="$(json_string_escape "${level_name}")"
  server_name="$(pixi run python -c 'import sys; from minerec.config import load_config; print(load_config(sys.argv[1]).server.name)' "${config_file}")"
  server_instance_id="$(pixi run python -c 'import sys; from minerec.config import load_config; print(load_config(sys.argv[1]).server.instance_id)' "${config_file}")"
  server_name="$(json_string_escape "${server_name}")"

  cat > "${config_dir}/server-replay/config.json" <<EOF
{
  "allow_downloading_replays": false,
  "automatically_record": true,
  "chunk_recorder_load_radius": -1,
  "chunk_recording_path": "/data/mc-recorder/server-replay/chunks",
  "chunk_recording_strategy": "always",
  "chunks": [],
  "default_encoding": "flashback",
  "delete_replays_after_duration": "0s",
  "ignore_action_bar_packets": false,
  "ignore_chat_packets": true,
  "ignore_custom_payloads": false,
  "ignore_light_packets": false,
  "ignore_scoreboard_packets": false,
  "ignore_sound_packets": false,
  "include_resource_packs": true,
  "log_deleted_replays": true,
  "max_duration": "0s",
  "max_file_size": "0 B",
  "notify_admins_of_status": true,
  "optimize_entity_packets": false,
  "optimize_explosion_packets": true,
  "pause_notify_players": false,
  "player_predicate": {"type": "all"},
  "player_recording_name": "{uuid}",
  "player_recording_path": "/data/mc-recorder/server-replay/players",
  "record_hotbar": true,
  "record_voice_chat": false,
  "recover_unsaved_replays": true,
  "replay_server_ip": null,
  "restart_after_max_duration": false,
  "restart_after_max_file_size": false,
  "server_name": "mc-recorder",
  "world_name": "${level_name}"
}
EOF

  cat > "${config_dir}/mc-recorder.json" <<EOF
{
  "artifacts_root": "/artifacts",
  "server_name": "${server_name}",
  "server_instance_id": "${server_instance_id}",
  "include_inventory_components": true,
  "record_all_players": true,
  "writer_queue_capacity": 65536
}
EOF

  echo "Prepared Minecraft runtime:"
  echo "  mod: ${mods_dir}/mc-recorder-capture.jar"
  echo "  config: ${config_dir}"
}

compose_command() {
  require_env_file
  require_command docker
  cd "${ROOT}"
  "${COMPOSE[@]}" "$@"
}

command="${1:-}"
if [[ -z "${command}" || "${command}" == "-h" || "${command}" == "--help" ]]; then
  usage
  exit 0
fi
shift

case "${command}" in
  prepare)
    prepare "$@"
    ;;
  start)
    prepare
    compose_command up --detach --remove-orphans --wait --wait-timeout 180 "$@"
    ;;
  stop)
    compose_command stop --timeout 120 "$@"
    ;;
  restart)
    compose_command stop --timeout 120
    prepare
    compose_command up --detach --remove-orphans --wait --wait-timeout 180 "$@"
    ;;
  status)
    compose_command ps "$@"
    ;;
  logs)
    compose_command logs "$@"
    ;;
  *)
    echo "unknown minecraft-server command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
