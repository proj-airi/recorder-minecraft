#!/usr/bin/env bash
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

for command in pixi pnpm; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "missing required command: ${command}" >&2
    exit 127
  fi
done

if [[ "${MC_RECORDER_SKIP_DASHBOARD_BUILD:-}" != "1" ]]; then
  pnpm install
  pnpm build:dashboard
fi

if [[ -z "${MC_RECORDER_DASHBOARD_USERNAME:-}" ]]; then
  echo "missing MC_RECORDER_DASHBOARD_USERNAME" >&2
  exit 2
fi

if [[ -z "${MC_RECORDER_DASHBOARD_PASSWORD:-}" ]]; then
  echo "missing MC_RECORDER_DASHBOARD_PASSWORD" >&2
  exit 2
fi

exec pixi run mc-recorder dashboard serve "$@"
