#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: hack/dashboard <command> [args...]

Commands:
  build    Install workspace Node dependencies and build dashboard assets
  start    Build unless skipped, then serve the host dashboard
  serve    Serve the host dashboard without building assets
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

require_dashboard_credentials() {
  if [[ -z "${MC_RECORDER_DASHBOARD_USERNAME:-}" ]]; then
    echo "missing MC_RECORDER_DASHBOARD_USERNAME" >&2
    exit 2
  fi

  if [[ -z "${MC_RECORDER_DASHBOARD_PASSWORD:-}" ]]; then
    echo "missing MC_RECORDER_DASHBOARD_PASSWORD" >&2
    exit 2
  fi
}

build_dashboard() {
  require_command pnpm
  cd "${ROOT}"
  pnpm install
  pnpm build:dashboard
}

serve_dashboard() {
  require_command pixi
  require_dashboard_credentials
  cd "${ROOT}"
  exec pixi run minerec dashboard serve "$@"
}

command="${1:-}"
if [[ -z "${command}" || "${command}" == "-h" || "${command}" == "--help" ]]; then
  usage
  exit 0
fi
shift

case "${command}" in
  build)
    build_dashboard "$@"
    ;;
  start)
    if [[ "${MC_RECORDER_SKIP_DASHBOARD_BUILD:-}" != "1" ]]; then
      build_dashboard
    fi
    serve_dashboard "$@"
    ;;
  serve)
    serve_dashboard "$@"
    ;;
  *)
    echo "unknown dashboard command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
