#!/usr/bin/env bash
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

for command in proto pixi; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "missing required command: ${command}" >&2
    exit 127
  fi
done

proto install --config-mode local
pixi install --locked

if [[ ! -f recorder.toml ]]; then
  pixi run minerec init
fi

cat <<'EOF'

Installed local toolchains and Pixi environment.

Next:
  1. Review https://aka.ms/MinecraftEULA
  2. Set server.eula = true in recorder.toml
  3. Run ./hack/start-minecraft-server
EOF
