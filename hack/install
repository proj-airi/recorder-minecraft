#!/usr/bin/env bash
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

if ! command -v proto >/dev/null 2>&1; then
  echo "missing required command: proto" >&2
  exit 127
fi

proto install --config-mode local

if [[ ! -f recorder.toml ]]; then
  go run ./cmd/recorder-minecraft init
fi

if [[ ! -f deploy/.env ]]; then
  cp deploy/.env.example deploy/.env
fi

cat <<'EOF'

Installed local toolchains.

Next:
  1. Review https://aka.ms/MinecraftEULA
  2. Set MC_EULA=TRUE in deploy/.env
  3. Run ./hack/minecraft-server start
EOF
