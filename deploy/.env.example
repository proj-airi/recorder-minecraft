# Copy this file to deploy/.env before running Docker Compose directly.
# Relative host paths are resolved from deploy/docker-compose.yml.

MC_EULA=FALSE
MC_VERSION=1.21.8
MC_FABRIC_LOADER_VERSION=0.19.3
MC_PORT=25565
MC_MEMORY=4G
MC_SEED=
MC_GAME_MODE=survival
MC_DIFFICULTY=normal
MC_VIEW_DISTANCE=10
MC_SIMULATION_DISTANCE=10
MC_ONLINE_MODE=true
MC_MAX_PLAYERS=20
MC_LEVEL_NAME=world
MC_MOTD=Minecraft dataset recorder
MC_MODRINTH_PROJECTS=server-replay:TbWIikrT
MC_CAPTURE_EPOCH_TICKS=6000

MC_DATA_DIR=../artifacts/server
MC_LOCAL_MODS_DIR=../.mc-recorder/mods
MC_CONFIG_SOURCE_DIR=../.mc-recorder/config
MC_CAPTURE_DIR=../artifacts/captures
MC_REPLAY_DIR=../artifacts/replays
MC_CONTROL_DIR=../.mc-recorder/control
MC_CONFIG_FILE=../recorder.toml
MC_EXPORT_DIR=../artifacts/exports
MC_RUNTIME_DIR=../.mc-recorder
MC_DASHBOARD_PORT=8765
MC_DASHBOARD_STATIC_ROOT=../apps/dashboard/dist

MC_RECORDER_QUOTA_BYTES=107374182400
MC_RECORDER_WARN_PERCENT=80
MC_RECORDER_EVICT_OLDEST=true
MC_RECORDER_CHECK_INTERVAL=60

MC_RECORDER_DASHBOARD_USERNAME=recorder
MC_RECORDER_DASHBOARD_PASSWORD=replace-with-a-long-password
