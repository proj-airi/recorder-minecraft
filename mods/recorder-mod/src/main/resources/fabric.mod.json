{
  "schemaVersion": 1,
  "id": "mc-recorder",
  "version": "${version}",
  "name": "Minecraft Play Recorder",
  "description": "Synchronized server-side action and state capture companion for ServerReplay.",
  "authors": ["mc-play-recorder contributors"],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.mcdata.recorder.RecorderMod"
      }
    ]
  },
  "mixins": ["mc-recorder.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.136.1+1.21.8",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10",
    "minecraft": "1.21.8",
    "server-replay": ">=3.0.1"
  }
}
